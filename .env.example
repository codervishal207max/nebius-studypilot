# --- Nebius Token Factory (required) ---
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA Nemotron model. Check the exact name in the Token Factory console (Models)
# and paste it here (hackathon rule: use at least one NVIDIA open model).
LLM_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# Embeddings (for RAG). If this fails, the app falls back to keyword search automatically.
EMBED_MODEL=BAAI/bge-multilingual-gemma2

# --- Tavily web search (free tier) ---
TAVILY_API_KEY=your_tavily_key_here

# --- Telegram bot (optional): token from @BotFather ---
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated chat IDs allowed to use the bot.
# If empty, the first chat that messages the bot becomes its owner.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Public URL of your deployment (the calendar subscribe link is built from it) ---
PUBLIC_URL=http://localhost:8000

# --- App ---
DB_PATH=data/assistant.db
API_URL=http://localhost:8000
BRIEF_HOUR=8
BRIEF_MINUTE=0
TIMEZONE=Asia/Kolkata
